{
  "name": "vericert",
  "version": "2.0.0",
  "description": "VeriCert - Next-Gen Blockchain Certificate Platform",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "blockchain"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:push": "npm run db:push --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dev-vie/BC-Certificate-Verification.git"
  },
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
