# ─── VeriCert Environment Configuration ──────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication
JWT_SECRET=vericert_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=vericert_refresh_token_secret_key_2026

# Database (PostgreSQL / Supabase / Neon / Local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vericert?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vericert?schema=public"

# Storage (Supabase Storage with automatic fallback to local /public/uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TEMPLATES_BUCKET=templates
SUPABASE_CERTIFICATES_BUCKET=certificates

# Blockchain (Polygon Amoy Testnet)
# Get testnet MATIC at https://faucet.polygon.technology/
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
WALLET_PRIVATE_KEY=
CONTRACT_ADDRESS=
POLYGONSCAN_API_KEY=

# Email / Notifications (Optional - verification codes log to terminal if unset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@vericert.io
